{
  "schemaVersion": 1,
  "id": "two-services",
  "name": "Two services, in sequence",
  "description": "Run two checks in order. An unhealthy result does not stop the next check.",
  "steps": [
    {
      "id": "first-service",
      "name": "Check service in maintenance",
      "type": "http.check",
      "config": { "url": "${DEMO_URL}/unhealthy", "expectedStatus": 200, "timeoutMs": 3000 }
    },
    {
      "id": "second-service",
      "name": "Check healthy service",
      "type": "http.check",
      "config": { "url": "${DEMO_URL}/healthy", "expectedStatus": 200, "timeoutMs": 3000 }
    }
  ]
}
